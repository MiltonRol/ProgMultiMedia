<?xml version="1.0" encoding="utf-8"?>
<!-- Versión Vector Drawable de svg/circle.svg.
     Los VectorDrawable no tienen etiqueta <circle>: un círculo se dibuja con
     dos arcos (A) de media vuelta cada uno: de arriba (50,20) a abajo (50,80) y vuelta. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:pathData="M50,20 A30,30 0 1,1 50,80 A30,30 0 1,1 50,20"
        android:strokeColor="#FFFFB74D"
        android:strokeWidth="12" />
</vector>
